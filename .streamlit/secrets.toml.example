# -----------------------------------------------------------------------------
# Configuración de st.secrets para Streamlit Cloud
# Hoja Central Target: "BD Consola Enjoy - central"
# ID: 1dpA2Nnk9dZ_NVkhJD1HHRBN4CH6Ry8bzm2Iuf_oXV8Y
# -----------------------------------------------------------------------------

# Opción 1: Con Service Account (Recomendada)
# 1. Copie el contenido del archivo JSON de su Service Account de Google Cloud a esta estructura.
# 2. Comparta la hoja "BD Consola Enjoy - central" en Google Drive con el correo 'client_email' dando permisos de "Editor".

[gsheets]
spreadsheet = "1dpA2Nnk9dZ_NVkhJD1HHRBN4CH6Ry8bzm2Iuf_oXV8Y"
type = "service_account"
project_id = "TU_PROJECT_ID"
private_key_id = "TU_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
client_email = "tu-service-account@tu-proyecto.iam.gserviceaccount.com"
client_id = "TU_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"

# -----------------------------------------------------------------------------
# Opción 2: Con Google Apps Script Web App (Alternativa rápida)
# Si desplegó un Script Web App en la hoja Google Sheets:
# gsheets_url = "https://script.google.com/macros/s/TU_SCRIPT_ID/exec"
# -----------------------------------------------------------------------------
